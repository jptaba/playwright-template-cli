# dependencies
node_modules/
.npm/
.cache/

# --- secrets & session material ----------------------------------------------
# storageState files contain live session tokens. Anyone holding one is signed
# in as that account with no password or MFA required. Never commit, never
# publish as a CI artifact.
.auth/
*.storagestate.json

.env
.env.*
!.env.example
*.pem
*.key

# --- Playwright output --------------------------------------------------------
# Accessibility snapshots written by @playwright/cli during exploration. They
# contain rendered application content and are authoring scratch, not source.
.playwright-cli/
blob-report/
playwright-report/
test-results/
results/
.last-run.json

# --- generated run data -------------------------------------------------------
run-result.json
triage-result.json
.practitest-cache.json
report-out/

# NOTE: docs/generated/ is deliberately NOT ignored. The capability catalog is
# committed so CI can diff it against a fresh build and fail on drift.

# --- editors / OS -------------------------------------------------------------
.DS_Store
Thumbs.db
*.log

# Per-run artefacts, models and event streams from the dashboard.
# Pruned on start against two caps together: 20 runs and 2 GB, oldest first.
.runs/

# The half-typed onboarding form, kept between page loads. Scratch, not a record.
.onboarding-draft.json

# Real test-user credentials, kept out of git. The shared
# config/secrets.local.json is tracked and is only for logins a vendor already
# publishes; anything real goes here and takes precedence over it.
config/secrets.private.json
