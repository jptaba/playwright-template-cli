# dependencies
node_modules/
.npm/
.cache/

# --- secrets & session material ----------------------------------------------
# storageState files contain live session tokens. Anyone holding one is signed
# in as that account with no password or MFA required. Never commit, never
# publish as a CI artifact.
.auth/
*.storagestate.json

.env
.env.*
!.env.example
*.pem
*.key

# --- Playwright output --------------------------------------------------------
# Accessibility snapshots written by @playwright/cli during exploration. They
# contain rendered application content and are authoring scratch, not source.
.playwright-cli/
blob-report/
playwright-report/
test-results/
results/
.last-run.json

# --- generated run data -------------------------------------------------------
run-result.json
triage-result.json
.practitest-cache.json
report-out/

# NOTE: docs/generated/ is deliberately NOT ignored. The capability catalog is
# committed so CI can diff it against a fresh build and fail on drift.

# --- editors / OS -------------------------------------------------------------
.DS_Store
Thumbs.db
*.log

# Per-run artefacts, models and event streams from the dashboard.
# Pruned on start against two caps together: 20 runs and 2 GB, oldest first.
.runs/

# The half-typed onboarding form, kept between page loads. Scratch, not a record.
.onboarding-draft.json

# Which application the dashboard is scoped to. Whose screen it is, not what
# the repository holds — a profile describes the application, this describes
# the person looking at one.
.dashboard-selection.json

# Real test-user credentials, kept out of git. The shared
# config/secrets.local.json is tracked and is only for logins a vendor already
# publishes; anything real goes here and takes precedence over it.
config/secrets.private.json

# Which Vault this machine is connected to, written by the dashboard once a
# connection has been proved. An address, a namespace and a mount — never a
# credential, which is why it can be written down at all. Whose Vault it is
# describes the machine, not the application, so it is not in config/targets/.
.vault-connection.json

# Account leases. One file per held account, so separate Playwright worker
# processes can wait for a free identity instead of silently sharing one.
# Machine-local and safe to delete: a stale lock is reclaimed by TTL anyway.
.locks/
